# Neon server-side pooled connection. Use a restricted runtime role.
DATABASE_URL=postgresql://app_runtime_user:password@your-neon-pooler-host/dbname?sslmode=require

# Neon Auth
VITE_NEON_AUTH_URL=https://your-neon-auth-endpoint/neondb/auth
NEON_AUTH_BASE_URL=https://your-neon-auth-endpoint/neondb/auth
NEON_AUTH_JWKS_URL=https://your-neon-auth-endpoint/neondb/auth/.well-known/jwks.json

# Stripe
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_key_here
STRIPE_SECRET_KEY=sk_test_replace_me
APP_BASE_URL=https://sourcesevens.vercel.app

# MFA encryption (32 random bytes, base64 encoded)
MFA_ENCRYPTION_KEY=replace_with_base64_encoded_32_byte_key

# Neon Object Storage (S3-compatible, server-only)
AWS_ENDPOINT_URL_S3=https://your-neon-object-storage-endpoint
AWS_REGION=us-east-2
AWS_S3_BUCKET=product-images
AWS_ACCESS_KEY_ID=replace_me
AWS_SECRET_ACCESS_KEY=replace_me

# Keep false until an order-email provider route is configured.
VITE_ORDER_EMAIL_NOTIFICATIONS=false
