# Stripe Configuration
# Get your keys from: https://dashboard.stripe.com/apikeys
# For testing, use test keys (pk_test_... and sk_test_...)
# For production, use live keys (pk_live_... and sk_live_...)

# Stripe Publishable Key (Client-side)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_key_here

# Supabase Configuration
VITE_SUPABASE_URL=https://erxkwytqautexizleeov.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImVyeGt3eXRxYXV0ZXhpemxlZW92Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3NjQ1NDc4NTAsImV4cCI6MjA4MDEyMzg1MH0.IeKfNvkLNVxvtX-dl8U9xqlv3LIzX6AHLpqiZRcvjVs

# Server-only Vercel API configuration. Use the same project URL and public
# anon key; never use a service-role/secret key for request authentication.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_public_anon_key

# Server-only pooled Neon connection for runtime. Use a restricted role, not
# the Neon owner/migration role. Keep DATABASE_URL out of all VITE_* variables.
DATABASE_URL=postgresql://app_role:password@your-neon-pooler-host/dbname?sslmode=require

# Enable only in an environment with server-side DATABASE_URL configured.
# This switches public product reads to the Vercel /api/products endpoint.
VITE_USE_NEON_PRODUCT_API=false

# Neon Auth URL from Neon Console > Project > Branch (main) > Auth > Configuration.
# The VITE_ value is public and used by the browser auth client.
VITE_NEON_AUTH_URL=https://your-neon-auth-endpoint/neondb/auth

# Server-only JWT verification settings for Vercel API routes.
NEON_AUTH_BASE_URL=https://your-neon-auth-endpoint/neondb/auth
NEON_AUTH_JWKS_URL=https://your-neon-auth-endpoint/neondb/auth/.well-known/jwks.json

# Service Role Key (Server-side only - bypasses RLS)
# ⚠️ CRITICAL: Never expose this key in client-side code or commit to public repos
# Get this from your Supabase project settings > API > service_role (secret)
# Never use a VITE_ prefix for a service-role key: Vite exposes VITE_* values to
# browser bundles. Store this secret only in Supabase Edge Function secrets or
# in your server host's private environment configuration.
# Server-only variable name: SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
